---
import "../styles/blog.css";
import "prism-theme-vars/base.css";

import BlogPostListItemInfoBar from "../components/blog/BlogPostListItemInfoBar.astro";
import Layout from "./Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"blog">["data"];
};

const { post } = Astro.props;
const coverImage = "cover_image" in post ? post.cover_image : undefined;
---

<Layout
  title={post.title}
  description={post.excerpt}
  socialCard={coverImage
    ? {
        image: coverImage.src.src,
        type: "article",
        twitterType: "summary_large_image",
      }
    : undefined}
>
  <h1 class="text-h2 uppercase text-primary">{post.title}</h1>
  <BlogPostListItemInfoBar post={post} />

  {
    coverImage && (
      <div class="my-5">
        <div class="isolate aspect-image overflow-hidden rounded-2xl">
          <Image src={coverImage.src as ImageMetadata} alt="" />
        </div>
        <p class="mt-1 text-center text-details">
          Cover image source:{" "}
          <a class="underline" href={coverImage.credit_link} target="_blank">
            {coverImage.credit_text}
          </a>
        </p>
      </div>
    )
  }

  <div class="text-body">
    <section class="mb-5 border-b border-dotted border-b-text pb-7.5">
      <span class="text-primary">Post contents:{" "}</span>
      {post.excerpt}
    </section>

    <div class="blog-content">
      <slot />
    </div>
  </div>
</Layout>
