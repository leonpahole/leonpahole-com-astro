---
import type { CollectionEntry } from "astro:content";
import BlogPostListItemInfoBar from "./BlogPostListItemInfoBar.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const isSubstack = "substack" in post.data;
const href =
  "substack" in post.data ? post.data.substack : `/blog/post/${post.data.slug}`;
---

<article class="py-4 sm:py-5">
  <h3 class="text-h3">
    <a href={href}>{post.data.title}</a>
  </h3>

  <BlogPostListItemInfoBar post={post.data} />

  <p class="my-5 text-body">{post.data.excerpt}</p>

  <a href={href} class="border-b border-text px-2.5 text-link">
    Read full blog post{isSubstack ? " (Substack)" : ""} &#x3e;&#x3e;
  </a>
</article>
